# BILL Spend & Expense (Divvy)
BILL_API_TOKEN=
BILL_BASE_URL=https://gateway.stage.bill.com/connect
# UUID of the custom field techs fill with the ServiceTitan job number
BILL_JOB_FIELD_UUID=
# Set after creating the webhook subscription; used for signature verification
BILL_WEBHOOK_SECRET=

# ServiceTitan (Integration Environment = sandbox)
ST_BASE_URL=https://api-integration.servicetitan.io
ST_AUTH_URL=https://auth-integration.servicetitan.io/connect/token
ST_CLIENT_ID=
ST_CLIENT_SECRET=
ST_APP_KEY=
ST_TENANT_ID=

# App
DATABASE_URL=postgres://localhost:5432/divvy_servicetitan
PORT=3000
# When to post the PO: "cleared" (settled amount, recommended) or "complete"
# (as soon as tech fills the job number; amount may still change)
POST_ON=cleared

# Notifications (optional in dev; exceptions log to stdout if unset)
SLACK_WEBHOOK_URL=

# AI layer (phase 2: receipt OCR + pricebook item adjudication)
# Decision: Sonnet for all calls — no model routing. ~2.4c/receipt, ~$12/mo at
# 500 tx/mo; single-model simplicity beats the ~$7/mo Haiku would save.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
